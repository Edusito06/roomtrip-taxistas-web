# Copiar a .env y completar. NO commitear el .env real.

# --- MongoDB ---
# En local, docker-compose levanta Mongo y no necesitas tocar esto.
# En la nube, pega aqui el connection string de MongoDB Atlas.
MONGO_URI_REGISTRY=mongodb://mongo:27017/taxi_registry
MONGO_URI_RATINGS=mongodb://mongo:27017/taxi_ratings

# --- JWT ---
# Secreto compartido entre gateway, taxista-service y calificacion-service.
# Minimo 32 caracteres. Generar con: openssl rand -base64 48
JWT_SECRET=cambiame-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRACION_MINUTOS=120

# --- Cloudinary (fotos de taxista y vehiculo, RF-WTX-002) ---
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- Superadmin inicial (se crea al arrancar si no existe) ---
SUPERADMIN_CORREO=superadmin@roomtrip.pe
SUPERADMIN_PASSWORD=cambiame

# --- Credencial de servicio de la app movil (rol APP_MOVIL) ---
# Se crea al arrancar y, si cambias esta clave y reinicias, se actualiza sola.
# En produccion el servicio no arranca con 'cambiame' ni con claves de menos de 12 caracteres.
APP_MOVIL_CORREO=app-movil@roomtrip.pe
APP_MOVIL_PASSWORD=cambiame

# --- URLs internas (docker-compose las resuelve por nombre de servicio) ---
TAXISTA_SERVICE_URL=http://taxista-service:8081
CALIFICACION_SERVICE_URL=http://calificacion-service:8082
GATEWAY_URL=http://gateway-service:8080
